# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persona engine
# Required for real Claude persona generation. Without this, the app uses the deterministic fallback persona.
ANTHROPIC_API_KEY=sk-ant-...

# Vana
# Use Moksha for testnet/local development; switch to mainnet for launch.
VANA_NETWORK=moksha
VANA_APP_PRIVATE_KEY=0x...
VANA_APP_URL=http://localhost:3000

# Optional local/dev override for the mocked approval flow.
# In production this should point at the real Vana/Personal Server approval URL from your integration.
VANA_APPROVAL_URL=http://localhost:3000/connect/return

# Persistent storage
# If omitted, the app falls back to local .mirror-store/db.json storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Referral leaderboard / manual Cup standing
# Used by POST /api/admin/cup-standing as: Authorization: Bearer <token>
MIRROR_ADMIN_TOKEN=

# Projection panel defaults. Update these if the Cup prize pool or price reference changes.
MIRROR_CUP_WINNER_VANA=5000
MIRROR_CUP_PLACE_VANA=500
MIRROR_VANA_PRICE_USD=1.18
MIRROR_VANA_PRICE_DATE=August 1, 2026
